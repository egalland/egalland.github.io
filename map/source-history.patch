--- /dev/null
+++ b/lib/site-architecture.ts
@@ -0,0 +1,13 @@
+import source from './generated/site-architecture.json';
+export type ArchitectureNode={id:string;label:string;path:string;group:string;description:string;exports:string[];count?:number};
+export type ArchitectureEdge={source:string;target:string;kind:string};
+export type ArchitectureGraph={nodes:ArchitectureNode[];edges:ArchitectureEdge[]};
+export const architecture=source as {schema:number;groups:Record<string,{label:string;color:string}>;nodes:ArchitectureNode[];edges:ArchitectureEdge[]};
+export function architectureView(mode:'overview'|'modules',group:string,query:string):ArchitectureGraph{
+ const q=query.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
+ const shown=architecture.nodes.filter(n=>(group==='all'||n.group===group)&&(!q||[n.label,n.path,n.description,...n.exports].join(' ').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().includes(q)));
+ if(mode==='modules'||group!=='all'||q){const ids=new Set(shown.map(n=>n.id));return {nodes:shown,edges:architecture.edges.filter(e=>ids.has(e.source)&&ids.has(e.target))};}
+ const nodes=Object.entries(architecture.groups).map(([id,g])=>({id:'group:'+id,label:g.label,path:'',group:id,description:`${architecture.nodes.filter(n=>n.group===id).length} composants. Sélectionne « Ouvrir ce groupe » pour les explorer.`,exports:[],count:architecture.nodes.filter(n=>n.group===id).length})).filter(n=>n.count);
+ const links=new Map<string,ArchitectureEdge>();for(const e of architecture.edges){const a=architecture.nodes.find(n=>n.id===e.source)!,b=architecture.nodes.find(n=>n.id===e.target)!;if(a.group!==b.group)links.set(a.group+'>'+b.group,{source:'group:'+a.group,target:'group:'+b.group,kind:'group'});}
+ return {nodes,edges:[...links.values()]};
+}
